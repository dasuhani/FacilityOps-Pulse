# ============================================================
# FacilityOps Pulse - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=facilityops_pulse
DB_USER=facilityops_user
DB_PASSWORD=your_secure_password_here

# Alternatively, set the full connection string (takes precedence over individual fields above)
# DATABASE_URL=postgresql://facilityops_user:your_secure_password_here@localhost:5432/facilityops_pulse

# --- Groq API ---
# Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for LLM features
# Recommended: llama-3.3-70b-versatile or mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# --- Sentence Transformers ---
# Model name from HuggingFace for semantic similarity
# Downloaded automatically on first run (~90MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Application Settings ---
APP_NAME=FacilityOps Pulse
APP_ENV=development
# Set to 'production' in production deployments

# Session secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=replace_with_a_random_64_char_hex_string

# --- Logging ---
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/facilityops.log

# --- Feature Flags ---
# Set to 'false' to disable AI features (useful when Groq key is not yet set)
ENABLE_AI_FEATURES=true
ENABLE_SEMANTIC_SEARCH=true
